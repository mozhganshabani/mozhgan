from playwright.sync_api import Page, expect

def test_empty_form_submission(page: Page):
  
    page.goto("file:///C:/path/to/your/index.html")

    page.locator("#submit").click()
    
    error_message = page.locator(".error-msg")
    
    expect(error_message).to_be_visible()
    expect(error_message).to_contain_text("فیلدها اجباری است")

    page.locator("#username").fill("my_test_user")

    # ۳. پیدا کردن دکمه و کلیک روی آن
    page.locator("#loginBtn").click()
 page.locator("#username").fill("testuser_playwright")
    
    # پیدا کردن رمز عبور با استفاده از کلاس (CSS Selector: .pass-input)
    # چون id پاک شده بود، از کلاسی که مخصوص خودش است استفاده کردیم
    page.locator(".pass-input").fill("password123")
    
    # کلیک روی دکمه ثبت نام با ID
    page.locator("#register-btn").click()
    
    # یک توقف کوتاه برای دیدن نتیجه (در پروژه‌های واقعی به جای sleep از expect استفاده می‌کنیم)
    time.sleep(1)

    # کلیک روی دکمه ورود با استفاده از ویژگی data-testid
    # پلی‌رایت یک متد مخصوص برای این ویژگی استاندارد تست دارد
    page.get_by_test_id("login-button").click()
    time.sleep(1)


